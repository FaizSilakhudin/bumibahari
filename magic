#!/usr/bin/env php
<?php

require __DIR__ . '/vendor/autoload.php';

use Core\Database;
use Core\Migration;
use Core\Generator;

Database::boot();

$command = $argv[1] ?? null;

switch ($command) {

    case 'migrate':
        Migration::run();
        break;

    case 'migrate:rollback':
        Migration::rollback();
        break;

    case 'migrate:fresh':
        Migration::fresh();
        break;

    case 'make:migration':

        $name = $argv[2] ?? null;

        if (!$name) {
            echo "Migration name is required.\n";
            echo "Example:\n";
            echo "  php console make:migration create_products_table\n";
            exit;
        }

        Generator::migration($name);
        break;

    case 'make:model':

        $name = $argv[2] ?? null;

        if (!$name) {
            echo "Model name is required.\n";
            echo "Example:\n";
            echo "  php console make:model Product\n";
            exit;
        }

        $withMigration = in_array('-m', $argv);

        if ($withMigration) {
            Generator::modelWithMigration($name);
        } else {
            Generator::model($name);
        }

        break;

    default:

        echo "\n";
        echo "Native PHP Framework\n";
        echo "====================\n\n";

        echo "Available commands:\n\n";

        echo "  php console migrate\n";
        echo "  php console migrate:rollback\n";
        echo "  php console migrate:fresh\n";
        echo "  php console make:migration <name>\n";
        echo "  php console make:model <name>\n";

        echo "\n";
        break;
}
